# ── Network ────────────────────────────────────────────────────────────────
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
CHAIN_ID=43113

# ── Keys (never commit .env) ───────────────────────────────────────────────
# Deploys Pythia contracts (Hardhat). Needs Fuji AVAX.
DEPLOYER_PRIVATE_KEY=
# Resolver's own EOA: settles markets, publishes pool totals, signs payouts. Needs Fuji AVAX.
RESOLVER_PRIVATE_KEY=
# Passphrase used by the resolver to encrypt the per-market YES/NO pool account keystore at rest.
POOL_KEYSTORE_PASSPHRASE=
POOL_KEYSTORE_PATH=./resolver/keystore
# SQLite bet ledger
LEDGER_DB_PATH=./resolver/data/ledger.sqlite
# AVAX sent to each new pool account for gas
POOL_GAS_FUND=0.1
# Simulated bettors for resolver/scripts/placeBet.ts (--wallet N reads BETTOR_PRIVATE_KEY_N)
BETTOR_PRIVATE_KEY_1=
BETTOR_PRIVATE_KEY_2=

# ── eERC (deployed on Fuji, from eerc-backend-converter / PHANTOM) ────────
EERC_ADDRESS=0xFd9E9E078341f18bA29c14404D17D2f7ef1d63D8
REGISTRAR_ADDRESS=0x281D95Fbe23b4Ec33EcF6d4e174F57AA2A0bE6c9
# Fuji USDC (the ERC20 wrapped by the converter)
USDC_ADDRESS=0x5425890298aed601595a70AB815c96711a31Bc65

# ── Pythia contracts (filled in by later phases after deployment) ─────────
PYTHIA_MARKETS_ADDRESS=0xe21D7327eAd6E53AF7549Bd82942C03DF8c7eF44
# Address of the RESOLVER_PRIVATE_KEY wallet (passed to the PythiaMarkets constructor).
RESOLVER_ADDRESS=
# Optional: Snowtrace/Routescan API key for verification (any non-empty value works on testnet).
SNOWTRACE_API_KEY=

# ── Resolver behaviour ─────────────────────────────────────────────────────
# K: minimum NEW bets since the last publish before pool totals may be published on-chain.
BATCH_MIN_BETS=3
RESOLVER_POLL_INTERVAL_MS=15000

# ── Testing ────────────────────────────────────────────────────────────────
# A Fuji wallet already registered on the Registrar (used by packages/eerc-core test:decrypt).
TEST_PRIVATE_KEY=

# ── Frontend (exposed to the browser; no secrets here) ────────────────────
NEXT_PUBLIC_CHAIN_ID=43113
NEXT_PUBLIC_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
NEXT_PUBLIC_EERC_ADDRESS=0xFd9E9E078341f18bA29c14404D17D2f7ef1d63D8
NEXT_PUBLIC_REGISTRAR_ADDRESS=0x281D95Fbe23b4Ec33EcF6d4e174F57AA2A0bE6c9
NEXT_PUBLIC_USDC_ADDRESS=0x5425890298aed601595a70AB815c96711a31Bc65
NEXT_PUBLIC_PYTHIA_MARKETS_ADDRESS=0xe21D7327eAd6E53AF7549Bd82942C03DF8c7eF44
